{
  "name": "packio-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "API_MOCKS=1 next dev",
    "dev:uat": "API_MOCKS=1 MOCK_DATASET=uat next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "tokens": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "contrast": "tsx scripts/check-contrast.ts",
    "gen:api": "tsx scripts/gen-api.ts",
    "gen:api:check": "tsx scripts/gen-api.ts --check",
    "docs:sync": "tsx scripts/docs-sync.ts",
    "docs:sync:check": "tsx scripts/docs-sync.ts --check",
    "gen:triage": "tsx scripts/gen-triage.ts",
    "gen:rbac": "tsx scripts/gen-rbac.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:app && pnpm test:dieline",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lhci": "tsx scripts/lhci.ts",
    "release:hygiene": "tsx scripts/release-hygiene.ts",
    "e2e:journeys": "playwright test --project=journeys --workers=2",
    "e2e:perf": "playwright test --project=perf --workers=1",
    "e2e:integration": "E2E_BACKEND=real playwright test --project=integration",
    "e2e:ui": "playwright test --ui",
    "test:app": "vitest run --passWithNoTests",
    "test:dieline": "pnpm --filter @packio/dieline test",
    "build:packages": "pnpm --filter @packio/dieline build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build:packages && changeset publish",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "style:thumbnails": "tsx scripts/style-thumbnails.ts",
    "styles:render": "tsx scripts/styles-render.ts",
    "styles:render:check": "tsx scripts/styles-render.ts --check"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@line/liff": "^2.31.0",
    "@packio/dieline": "workspace:*",
    "@react-three/fiber": "^9.8.1",
    "@sentry/nextjs": "^11.0.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "konva": "^10.5.0",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "openapi-fetch": "^0.17.0",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-konva": "^19.0.10",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
