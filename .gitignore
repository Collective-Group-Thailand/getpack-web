node_modules/
.pnpm-store/

# build output
.next/
out/
dist/
*.tsbuildinfo

# test & tooling output
/coverage/
playwright-report/
test-results/
storybook-static/

# environment
.env
.env*.local
*.local

# local / editor
.DS_Store
.firebase/

# read-only reference checkout of the legacy Locopack app (CLAUDE.md: inspiration only)
/legacy/
# The legacy domain notes stay local, as they always have (they were ignored by the old unanchored rule).
/docs/legacy/

# Lighthouse CI run output (reports are uploaded as a CI artifact instead)
.lighthouseci/

# Style assets are build output (U3.3, ADR-0012); only the manifest with their hashes is committed.
/packages/dieline/generated/*
!/packages/dieline/generated/manifest.json

# U-F0.5: accounts the integration setup provisions on the local packio-api
e2e/integration/.state/
lighthouse/.port-*.json

# Interim third-party home photos (dev-only fallback, HOME_PHOTOS_LOCAL_MANIFEST): copied from
# packio-api public/media/home, never committed — their per-asset source is unverified.
/public/media/home/
