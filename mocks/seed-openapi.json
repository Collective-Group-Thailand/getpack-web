{
  "openapi": "3.1.0",
  "info": {
    "title": "Packio API — SEED (NOT THE BACKEND CONTRACT)",
    "version": "0.0.0-seed",
    "description": "SEED CONTRACT — hand-written, temporary, and NOT agreed by packio-api.\n\nThe real contract (`contract/openapi.json`, pinned by `contract.lock.json`) carries only `/health` today; auth ships in packio-api Deliverable B1.3. This file exists so F1.2 can build the clients, the BFF and the login flows without hand-writing response types, which CLAUDE.md forbids.\n\nEvery path and field below is taken from a written source, never invented:\n- `docs/contract/api-conventions.md` §4 (the token body and the refresh/logout/me endpoints)\n- `packio-api/docs/adr/0004-auth-audiences-and-tokens.md` (audiences, staff sign in with email + password, argon2id, opaque rotating refresh)\n- `packio-api/docs/prompts/B1-foundation.md` Deliverable 1.3, which names each path literally\n\nEvery operation here has a row in `docs/contract-requests.md` and a `// CONTRACT-REQUEST` marker on its mock. When B1.3 publishes, delete this file, drop the one `SeedPaths` line from `src/lib/api/schema.ts`, and every stale usage becomes a compile error.",
    "contact": {}
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Seed — served by MSW, never a real host"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "SEED. Token issuance for all three audiences."
    },
    {
      "name": "store.me",
      "description": "SEED. The signed-in customer."
    },
    {
      "name": "admin.me",
      "description": "SEED. The signed-in staff member, their permissions and menu entitlements."
    },
    {
      "name": "partner.me",
      "description": "SEED. The signed-in partner-factory user and their factory scopes."
    }
  ],
  "paths": {
    "/v1/auth/staff/login": {
      "post": {
        "operationId": "auth.staff.login",
        "summary": "Sign a staff member in with email and password",
        "description": "SEED. Email + password (argon2id server side), per packio-api ADR-0004. Issues a token with `aud: staff`, accepted only on `/v1/admin/*`.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffLoginRequest"
              },
              "example": {
                "email": "somchai.staff@packio.invalid",
                "password": "not-a-real-password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. Tokens in the body; this app puts them in httpOnly cookies (api-conventions §4).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                },
                "example": {
                  "accessToken": "seed.access.token.staff",
                  "accessTokenExpiresAt": "2026-09-23T14:15:00+07:00",
                  "refreshToken": "seed-refresh-token-staff",
                  "refreshTokenExpiresAt": "2026-10-23T14:00:00+07:00",
                  "subject": {
                    "id": "00000000-0000-4000-8000-000000000002",
                    "type": "staff",
                    "roles": [
                      "cs"
                    ],
                    "permissions": [
                      "orders.read",
                      "orders.update",
                      "quotations.create"
                    ],
                    "scopes": [
                      "platform"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/customer/otp/request": {
      "post": {
        "operationId": "auth.customer.otp.request",
        "summary": "Send a login OTP to a Thai mobile number",
        "description": "SEED. SMS OTP is the customer's primary sign-in (D-143 lists OTP as one of the critical SMS events). The response carries the policy — code length, expiry, resend cooldown, attempts left — so the UI renders API-owned values instead of hard-coding them (CLAUDE.md). No decision owns these numbers yet; see docs/contract-requests.md.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              },
              "example": {
                "phone": "0812345678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. An OTP was sent (or the cooldown from a previous send still applies).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpChallenge"
                },
                "example": {
                  "ref": "MOCK-4821",
                  "codeLength": 6,
                  "expiresAt": "2026-09-23T14:10:00+07:00",
                  "resendAfterSeconds": 60,
                  "attemptsRemaining": 5
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/customer/otp/verify": {
      "post": {
        "operationId": "auth.customer.otp.verify",
        "summary": "Exchange an OTP for a customer session",
        "description": "SEED. Issues a token with `aud: customer`, accepted only on `/v1/store/*`.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              },
              "example": {
                "phone": "0812345678",
                "ref": "MOCK-4821",
                "code": "000000"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. Tokens in the body; this app puts them in httpOnly cookies (api-conventions §4).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                },
                "example": {
                  "accessToken": "seed.access.token.customer",
                  "accessTokenExpiresAt": "2026-09-23T14:15:00+07:00",
                  "refreshToken": "seed-refresh-token-customer",
                  "refreshTokenExpiresAt": "2026-10-23T14:00:00+07:00",
                  "subject": {
                    "id": "00000000-0000-4000-8000-000000000001",
                    "type": "customer",
                    "roles": [
                      "customer"
                    ],
                    "permissions": [],
                    "scopes": []
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/customer/firebase": {
      "post": {
        "operationId": "auth.customer.firebase",
        "summary": "Exchange a Firebase ID token (Google or Apple) for a customer session",
        "description": "SEED. The browser obtains the ID token from the Firebase SDK; this app's server exchanges it, so no provider token ever reaches JS-readable storage.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FirebaseLoginRequest"
              },
              "example": {
                "idToken": "seed.firebase.id-token"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. Tokens in the body; this app puts them in httpOnly cookies (api-conventions §4).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                },
                "example": {
                  "accessToken": "seed.access.token.customer",
                  "accessTokenExpiresAt": "2026-09-23T14:15:00+07:00",
                  "refreshToken": "seed-refresh-token-customer",
                  "refreshTokenExpiresAt": "2026-10-23T14:00:00+07:00",
                  "subject": {
                    "id": "00000000-0000-4000-8000-000000000001",
                    "type": "customer",
                    "roles": [
                      "customer"
                    ],
                    "permissions": [],
                    "scopes": []
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/customer/line": {
      "post": {
        "operationId": "auth.customer.line",
        "summary": "Exchange a LINE Login authorisation code or LIFF token for a customer session",
        "description": "SEED. Covers both LINE Login on the web (authorisation code + redirect URI) and LIFF inside the LINE app (access token). Account linking is the backend's job (D-151, D-135 rewards linking).",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LineLoginRequest"
              },
              "example": {
                "code": "seed-line-auth-code",
                "redirectUri": "https://packio.invalid/auth/line/callback"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. Tokens in the body; this app puts them in httpOnly cookies (api-conventions §4).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                },
                "example": {
                  "accessToken": "seed.access.token.customer",
                  "accessTokenExpiresAt": "2026-09-23T14:15:00+07:00",
                  "refreshToken": "seed-refresh-token-customer",
                  "refreshTokenExpiresAt": "2026-10-23T14:00:00+07:00",
                  "subject": {
                    "id": "00000000-0000-4000-8000-000000000001",
                    "type": "customer",
                    "roles": [
                      "customer"
                    ],
                    "permissions": [],
                    "scopes": []
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/partner/login": {
      "post": {
        "operationId": "auth.partner.login",
        "summary": "Sign a partner-factory user in",
        "description": "SEED. Username + password, with an optional device PIN for shared shop-floor devices. Issues a token with `aud: partner` carrying `factory:<uuid>` scopes.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartnerLoginRequest"
              },
              "example": {
                "username": "seed.planner",
                "password": "not-a-real-password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. Tokens in the body; this app puts them in httpOnly cookies (api-conventions §4).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                },
                "example": {
                  "accessToken": "seed.access.token.partner",
                  "accessTokenExpiresAt": "2026-09-23T14:15:00+07:00",
                  "refreshToken": "seed-refresh-token-partner",
                  "refreshTokenExpiresAt": "2026-10-23T14:00:00+07:00",
                  "subject": {
                    "id": "00000000-0000-4000-8000-000000000003",
                    "type": "partner",
                    "roles": [
                      "planner"
                    ],
                    "permissions": [
                      "jobs.read",
                      "jobs.update"
                    ],
                    "scopes": [
                      "factory:00000000-0000-4000-8000-0000000000f1"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "auth.refresh",
        "summary": "Rotate a refresh token for a new session",
        "description": "SEED. Refresh tokens are opaque, single-use and rotating; presenting an already-rotated token revokes the whole session family (api-conventions §4).",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              },
              "example": {
                "refreshToken": "seed-refresh-token"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SEED. Tokens in the body; this app puts them in httpOnly cookies (api-conventions §4). The audience follows the refresh token that was presented; this example shows a staff session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                },
                "example": {
                  "accessToken": "seed.access.token.staff",
                  "accessTokenExpiresAt": "2026-09-23T14:15:00+07:00",
                  "refreshToken": "seed-refresh-token-staff",
                  "refreshTokenExpiresAt": "2026-10-23T14:00:00+07:00",
                  "subject": {
                    "id": "00000000-0000-4000-8000-000000000002",
                    "type": "staff",
                    "roles": [
                      "cs"
                    ],
                    "permissions": [
                      "orders.read",
                      "orders.update",
                      "quotations.create"
                    ],
                    "scopes": [
                      "platform"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "auth.logout",
        "summary": "Revoke the current session",
        "description": "SEED. Revokes the session behind the refresh token. Idempotent: an unknown or already-revoked token still answers 204, so signing out never fails in the UI.",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              },
              "example": {
                "refreshToken": "seed-refresh-token"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "SEED. The session is revoked."
          }
        }
      }
    },
    "/v1/store/me": {
      "get": {
        "operationId": "store.me.show",
        "summary": "The signed-in customer",
        "description": "SEED. Requires a `customer` token.",
        "tags": [
          "store.me"
        ],
        "security": [
          {
            "customer": []
          }
        ],
        "responses": {
          "200": {
            "description": "SEED. The signed-in customer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerMe"
                },
                "example": {
                  "id": "00000000-0000-4000-8000-000000000001",
                  "type": "customer",
                  "displayName": "ลูกค้าตัวอย่าง (ข้อมูลจำลอง)",
                  "userCode": "MOCK-C-0001",
                  "phone": "0812345678",
                  "email": "seed.customer@packio.invalid",
                  "locale": "th",
                  "lineLinked": false,
                  "companies": [],
                  "scopes": []
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/admin/me": {
      "get": {
        "operationId": "admin.me.show",
        "summary": "The signed-in staff member, with permissions, menu entitlements and feature flags",
        "description": "SEED. Requires a `staff` token. The admin sidebar is built from `menu` rather than from hard-coded role checks (F1 1.3); the API stays the enforcement point (ADR-0005).",
        "tags": [
          "admin.me"
        ],
        "security": [
          {
            "staff": []
          }
        ],
        "responses": {
          "200": {
            "description": "SEED. The signed-in staff member.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMe"
                },
                "example": {
                  "id": "00000000-0000-4000-8000-000000000002",
                  "type": "staff",
                  "displayName": "พนักงานตัวอย่าง (ข้อมูลจำลอง)",
                  "email": "seed.staff@packio.invalid",
                  "locale": "th",
                  "roles": [
                    "cs"
                  ],
                  "permissions": [
                    "orders.read",
                    "orders.update",
                    "quotations.create"
                  ],
                  "scopes": [
                    "platform"
                  ],
                  "menu": [
                    {
                      "key": "dashboard",
                      "href": "/",
                      "icon": "box"
                    },
                    {
                      "key": "orders",
                      "href": "/orders",
                      "icon": "package",
                      "children": [
                        {
                          "key": "orders.all",
                          "href": "/orders"
                        }
                      ]
                    }
                  ],
                  "features": {
                    "labelCalculator": true
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/partner/me": {
      "get": {
        "operationId": "partner.me.show",
        "summary": "The signed-in partner-factory user and the factories they may act for",
        "description": "SEED. Requires a `partner` token. `factories` mirrors the `factory:<uuid>` scopes in the token.",
        "tags": [
          "partner.me"
        ],
        "security": [
          {
            "partner": []
          }
        ],
        "responses": {
          "200": {
            "description": "SEED. The signed-in partner user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerMe"
                },
                "example": {
                  "id": "00000000-0000-4000-8000-000000000003",
                  "type": "partner",
                  "displayName": "โรงงานตัวอย่าง (ข้อมูลจำลอง)",
                  "locale": "th",
                  "roles": [
                    "planner"
                  ],
                  "permissions": [
                    "jobs.read",
                    "jobs.update"
                  ],
                  "scopes": [
                    "factory:00000000-0000-4000-8000-0000000000f1"
                  ],
                  "factories": [
                    {
                      "id": "00000000-0000-4000-8000-0000000000f1",
                      "name": "โรงงานจำลอง หนึ่ง",
                      "status": "active"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "customer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "staff": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "partner": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Problem": {
        "description": "SEED. RFC 9457 problem details (api-conventions §3).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "example": {
              "type": "https://errors.packio/auth.invalid_credentials",
              "title": "Invalid credentials",
              "status": 401,
              "code": "auth.invalid_credentials",
              "detail": "อีเมลหรือรหัสผ่านไม่ถูกต้อง",
              "requestId": "00000000-0000-4000-8000-00000000000e"
            }
          }
        }
      }
    },
    "schemas": {
      "SubjectType": {
        "type": "string",
        "enum": [
          "customer",
          "staff",
          "partner"
        ]
      },
      "Subject": {
        "type": "object",
        "required": [
          "id",
          "type",
          "roles",
          "permissions",
          "scopes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/SubjectType"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "subject"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          }
        }
      },
      "StaffLoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "OtpRequest": {
        "type": "object",
        "required": [
          "phone"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "description": "Thai mobile number, national or E.164 form; the API normalises it."
          }
        }
      },
      "OtpChallenge": {
        "type": "object",
        "required": [
          "ref",
          "codeLength",
          "expiresAt",
          "resendAfterSeconds",
          "attemptsRemaining"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Shown to the user so they can match the SMS they received."
          },
          "codeLength": {
            "type": "integer",
            "description": "Digits in the code. The UI sizes its input from this rather than assuming 6."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAfterSeconds": {
            "type": "integer",
            "description": "Cooldown before Resend is offered again."
          },
          "attemptsRemaining": {
            "type": "integer"
          }
        }
      },
      "OtpVerifyRequest": {
        "type": "object",
        "required": [
          "phone",
          "ref",
          "code"
        ],
        "properties": {
          "phone": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "FirebaseLoginRequest": {
        "type": "object",
        "required": [
          "idToken"
        ],
        "properties": {
          "idToken": {
            "type": "string"
          }
        }
      },
      "LineLoginRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "LINE Login authorisation code (web flow)."
          },
          "redirectUri": {
            "type": "string",
            "description": "Must match the one used to obtain the code."
