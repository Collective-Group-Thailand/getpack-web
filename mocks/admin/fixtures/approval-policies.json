          "field": "amount",
          "op": "lte",
          "value": "100000.00"
        }
      },
      {
        "name": "C-Level (> THB 100,000)",
        "role": "c_level",
        "condition": {
          "field": "amount",
          "op": "gt",
          "value": "100000.00"
        }
      }
    ]
