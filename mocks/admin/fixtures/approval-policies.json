[
  {
    "key": "discount_memo",
    "subjectType": "discount_memo",
    "description": "Discounts above the CS limit; only the matching tier approves (D-052, D-162, D-124)",
    "decisions": ["D-052", "D-162", "D-124"],
    "reason": "Seed from D-052 / D-162 — tier boundaries are Proposed in D-052",
    "expiryRule": {
      "withSubject": "quote.valid_until"
    },
    "steps": [
      {
        "name": "Director (> 5–10 %)",
        "role": "director",
        "condition": {
          "all": [
            {
              "field": "pct",
              "op": "gt",
              "value": "5"
            },
            {
              "field": "pct",
              "op": "lte",
              "value": "10"
            },
            {
              "field": "flags",
              "op": "excludes",
              "value": "below_margin_floor"
            }
          ]
        }
      },
      {
        "name": "VP (> 10–15 %)",
        "role": "vp",
        "condition": {
          "all": [
            {
              "field": "pct",
              "op": "gt",
              "value": "10"
            },
            {
              "field": "pct",
              "op": "lte",
              "value": "15"
            },
            {
              "field": "flags",
              "op": "excludes",
              "value": "below_margin_floor"
            }
          ]
        }
      },
      {
        "name": "C-Level (> 15 % or below the margin floor)",
        "role": "c_level",
        "condition": {
          "any": [
            {
              "field": "pct",
              "op": "gt",
              "value": "15"
            },
            {
              "field": "flags",
              "op": "includes",
              "value": "below_margin_floor"
            }
          ]
        }
      }
    ]
  },
  {
    "key": "credit_limit",
