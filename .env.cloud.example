# getpack-web — environment for a Claude Code cloud session against the shared UAT API.
#
# Copy to .env.local in the session (`cp .env.cloud.example .env.local`). Safe values only: no
# secret belongs in this file. src/lib/env/schema.ts is the source of truth; .env.example
# documents every key in full.
#
# The UAT API is READ-ONLY from these sessions: GET requests only. Never submit forms, orders,
# payments, uploads or messages against it.

# ── Required (in production; dev/test fall back to localhost:3000 / localhost:4000) ──────────
# `pnpm dev` listens on :3001.
PUBLIC_HOST=localhost:3001
ADMIN_HOST=admin.localhost:3001
PARTNER_HOST=partner.localhost:3001
API_INTERNAL_URL=https://uat-api.getpack.co

# ── Optional server keys ──────────────────────────────────────────────────────────────────
# Comma-separated zones this process answers for. Leave commented: unset = all three, but
# `ZONES=` (empty) parses as an empty list.
# ZONES=customer
# Load balancers in front of this app appending to X-Forwarded-For; empty = 0.
TRUSTED_PROXY_HOPS=
API_CONTRACT_SOURCE=
HOME_PHOTOS_LOCAL_MANIFEST=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Build-time only (source-map upload); leave empty here.
SENTRY_AUTH_TOKEN=
# 1 = `next build` skips its own type check (CI runs `pnpm typecheck` instead).
NEXT_SKIP_TYPECHECK=

# ── Optional browser keys (NEXT_PUBLIC_* is public by definition) ─────────────────────────
NEXT_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_REALTIME_DRIVER=
NEXT_PUBLIC_REALTIME_KEY=
NEXT_PUBLIC_REALTIME_CLUSTER=
NEXT_PUBLIC_REALTIME_HOST=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_REPLAY_ENABLED=0
NEXT_PUBLIC_REPLAY_SAMPLE_RATE=
NEXT_PUBLIC_ASSISTANT=0
NEXT_PUBLIC_ENV_BADGE=uat

# ── Dev / test switches (not part of the app schema) ──────────────────────────────────────
# 1 = serve the in-process MSW mocks instead of API_INTERNAL_URL (`pnpm dev:mock`).
API_MOCKS=
# uat = the UAT mock dataset (`pnpm dev:uat`).
MOCK_DATASET=
