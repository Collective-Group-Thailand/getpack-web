# Build context for the production image (Dockerfile). Keep what `next build` reads; drop the rest.
# e2e/ and scripts/ stay in: `next build` type-checks every **/*.ts, and tests/scripts import across them.
.git
.github
**/node_modules
.next
**/.env
**/.env.*
!.env.example
*.log
.DS_Store
coverage
test-results
playwright-report
storybook-static
.lighthouseci
lighthouse
legacy
docs/legacy
*.tsbuildinfo
.vscode
.claude
