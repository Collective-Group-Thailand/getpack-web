# getpack-web — every environment variable this app reads.
#
# The schema in src/lib/env/schema.ts is the source of truth; this file documents it. Copy to
# .env.local for local work. Anything NEXT_PUBLIC_* is compiled into the browser bundle, so
# it is public by definition — nothing secret belongs on one of those lines.
#
# Outside production the hosts and the API URL default to the values shown, so `pnpm dev`
# needs no .env at all. In production they are required: a forgotten host would otherwise
# 404 every request in that zone with nothing in the logs to explain it.

# ── Zones ─────────────────────────────────────────────────────────────────────────────────
# One host per zone (00-master-plan.md §2). Host header values, not URLs; the port is
# ignored when matching, so the same values work on :3000, :3100 and :3200.
PUBLIC_HOST=localhost:3000
ADMIN_HOST=admin.localhost:3000
PARTNER_HOST=partner.localhost:3000

# Optional allow-list: which zones this deployment answers for. Unset means all three.
# The same image deployed twice can serve the storefront and the back office separately.
# ZONES=customer

# ── Backend (getpack-api) ──────────────────────────────────────────────────────────────────
# Server-to-server only. Browser code calls this app's own /bff/* instead (ADR-0005).
API_INTERNAL_URL=http://localhost:4000

# Load balancers in front of THIS app that append to X-Forwarded-For (0 = none, local dev).
# The visitor's address is the entry that many places from the right; the BFF, Server
# Components and Server Actions forward exactly that one address to getpack-api so its per-IP
# throttles see the visitor, not this app (getpack-api docs/launch/SECURITY.md §7 #1).
# getpack-api's TRUST_PROXY must then count this app as a hop: 1, plus one for each proxy
# between this app and the API (e.g. an internal load balancer → 2).
# TRUSTED_PROXY_HOPS=1

# `pnpm gen:api --adopt --tag vX.Y.Z` pins a tagged getpack-api release. It reads the tag from the
# sibling checkout named by `localSource` in contract.lock.json, or from a downloaded release
# asset named here (api-conventions.md §1). Plain `pnpm gen:api` always uses the vendored copy.
# API_CONTRACT_SOURCE=./openapi.json

# ── Assets & realtime ─────────────────────────────────────────────────────────────────────
# Dev only: fill the home page's empty photo slots from public/media/home/manifest.json (local
# stacks run getpack-api with fake, in-memory file storage, so CMS photos cannot be served).
# Refused in production; the interim photos also fail a production build (no-untracked-third-party-assets).
# HOME_PHOTOS_LOCAL_MANIFEST=1

# Stage C · C0 feature flags (off unless 1): the /styles "ช่วยเลือกให้หน่อย" wizard and the /packaging/[slug]
# landing pages, both waiting for business data / approved copy.
# FEATURE_STYLES_WIZARD=0
# FEATURE_PACKAGING_LANDINGS=0
# FEATURE_RFQ_PRODUCT_REF=0

# NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.getpack.co
# NEXT_PUBLIC_REALTIME_DRIVER=sse
# NEXT_PUBLIC_REALTIME_KEY=
# NEXT_PUBLIC_REALTIME_CLUSTER=
# NEXT_PUBLIC_REALTIME_HOST=

# ── Customer sign-in (F1 1.2) ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_LIFF_ID=
# LINE Official Account id for the floating chat button (e.g. @getpack). Optional: without it the API's
# support channel (lineOaId) is used, and with neither the button is hidden.
# NEXT_PUBLIC_LINE_OA_ID=

# ── Analytics, push, observability (F1 1.3) ───────────────────────────────────────────────
# Customer host only — admin and partner ship no third-party analytics (D-102).
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# The browser half. Unset means the SDK never loads in the browser, which keeps ~40 KB off
# every storefront page; server-side reporting still works from SENTRY_DSN alone.
# NEXT_PUBLIC_SENTRY_DSN=
# Session replay on the key journeys (U5.0): off unless 1; needs the browser DSN above and the
# visitor's analytics consent; all text, inputs and media masked. Not before counsel and the
# U2.0 data-terms answer. Sample rate 0–1, default 0.1.
# NEXT_PUBLIC_REPLAY_ENABLED=0
# NEXT_PUBLIC_REPLAY_SAMPLE_RATE=0.1
# getpack Assistant (U5.5): built into the storefront only when 1. Off at launch (D-218); even when
# built in, getpack-api decides whether a customer may use it (assistant.enabled, D-306).
# NEXT_PUBLIC_ASSISTANT=0

# ── Environment badge ─────────────────────────────────────────────────────────────────────
# uat | prod — shown in the admin topbar so nobody mistakes one for the other.
# NEXT_PUBLIC_ENV_BADGE=uat
