exports[`trust pages with nothing to show yet > network: is getpack's production standard, with no factory wording 1`] = `"<div class="mx-auto max-w-5xl px-5 pt-6 pb-16 md:px-8 md:pt-8 md:pb-20"><header><h1 class="text-[1.75rem] leading-[1.15] font-semibold tracking-tight text-balance md:text-[2.25rem]">มาตรฐานการผลิตของ getpack</h1><p class="text-muted mt-2 max-w-[62ch] text-pretty">ทุกงานที่สั่งผ่าน getpack ผ่านมาตรฐานการผลิตเดียวกัน ตั้งแต่ตรวจไฟล์จนถึงก่อนส่ง และ getpack เป็นผู้ขายที่รับผิดชอบงานของคุณตลอดทาง</p></header><div class="mt-8 flex flex-col gap-10"><section aria-labelledby="standard-quality"><h2 id="standard-quality" class="mb-3 text-xl font-semibold">ควบคุมคุณภาพ 4 ขั้น</h2><ol class="grid gap-3 sm:grid-cols-2"><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span aria-hidden="true" class="bg-primary-subtle text-primary-subtle-fg mb-1 grid size-7 place-items-center rounded-lg text-[0.8125rem] font-semibold tabular-nums">1</span><h3 class="font-semibold">ตรวจไฟล์และสเปก</h3><p class="text-muted text-sm">ทีมงานตรวจไฟล์ ขนาด วัสดุ และสเปกก่อนเริ่มผลิต หากมีจุดที่ต้องแก้ เราแจ้งคุณก่อนเริ่มผลิต</p></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span aria-hidden="true" class="bg-primary-subtle text-primary-subtle-fg mb-1 grid size-7 place-items-center rounded-lg text-[0.8125rem] font-semibold tabular-nums">2</span><h3 class="font-semibold">ตรวจระหว่างผลิต</h3><p class="text-muted text-sm">ตรวจงานระหว่างผลิตเทียบกับแบบและสเปกที่คุณอนุมัติ</p></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span aria-hidden="true" class="bg-primary-subtle text-primary-subtle-fg mb-1 grid size-7 place-items-center rounded-lg text-[0.8125rem] font-semibold tabular-nums">3</span><h3 class="font-semibold">ตรวจก่อนส่ง</h3><p class="text-muted text-sm">ตรวจขนาด สี และจำนวนตามเกณฑ์ด้านล่าง ก่อนปิดกล่องและจัดส่ง</p></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span aria-hidden="true" class="bg-primary-subtle text-primary-subtle-fg mb-1 grid size-7 place-items-center rounded-lg text-[0.8125rem] font-semibold tabular-nums">4</span><h3 class="font-semibold">รักษาความลับ</h3><p class="text-muted text-sm">ไฟล์และข้อมูลของคุณใช้เพื่อผลิตงานของคุณเท่านั้น ไม่นำไปเผยแพร่หรือใช้กับงานอื่น</p></li></ol></section><section aria-labelledby="standard-criteria"><h2 id="standard-criteria" class="mb-3 text-xl font-semibold">เกณฑ์ตรวจ</h2><ul class="grid gap-3 sm:grid-cols-3"><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span class="text-muted text-sm">ขนาด</span><span class="text-primary text-xl font-semibold tabular-nums">± 3 มม.</span><span class="text-muted text-sm">เทียบกับขนาดที่ระบุในคำสั่งซื้อ</span></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span class="text-muted text-sm">สี</span><span class="text-primary text-xl font-semibold tabular-nums">ΔE2000 ≤ 3</span><span class="text-muted text-sm">เทียบกับตัวอย่างที่คุณอนุมัติ</span></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><span class="text-muted text-sm">จำนวน</span><span class="text-primary text-xl font-semibold tabular-nums">± 5%</span><span class="text-muted text-sm">ส่วนที่ขาดคืนให้เป็นเครดิต</span></li></ul></section><section aria-labelledby="standard-visible"><h2 id="standard-visible" class="mb-3 text-xl font-semibold">สิ่งที่คุณเห็น</h2><ul class="grid gap-3 sm:grid-cols-2"><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><h3 class="font-semibold">แบบให้อนุมัติ</h3><p class="text-muted text-sm">ดูและอนุมัติแบบก่อนเริ่มผลิต</p></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><h3 class="font-semibold">สถานะ</h3><p class="text-muted text-sm">ติดตามสถานะคำสั่งซื้อได้ทุกขั้นตอน</p></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><h3 class="font-semibold">ผลตรวจ</h3><p class="text-muted text-sm">ดูผลตรวจคุณภาพของงานของคุณ</p></li><li class="rounded-card bg-surface border border-border p-4 flex flex-col gap-1"><h3 class="font-semibold">รับประกันงาน</h3><p class="text-muted text-sm">แจ้งเคลมได้ตามเงื่อนไขการรับประกัน</p></li></ul></section><section aria-labelledby="standard-faq"><h2 id="standard-faq" class="mb-3 text-xl font-semibold">คำถามที่พบบ่อย</h2><div class="divide-border border-border divide-y rounded-xl border"><details class="group"><summary class="focus-visible:ring-focus-ring flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3 font-medium outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><h3 class="text-base font-medium">ใครรับผิดชอบงานของฉัน</h3><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted mt-1 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="text-muted px-4 pb-4 leading-relaxed"><p>getpack เป็นผู้ขายและรับผิดชอบงานของคุณตั้งแต่สั่งซื้อจนถึงส่งมอบ มีปัญหาติดต่อเราที่เดียว</p></div></details><details class="group"><summary class="focus-visible:ring-focus-ring flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3 font-medium outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><h3 class="text-base font-medium">ไฟล์ของฉันปลอดภัยไหม</h3><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted mt-1 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="text-muted px-4 pb-4 leading-relaxed"><p>ไฟล์และข้อมูลของคุณใช้เพื่อผลิตงานของคุณเท่านั้น ไม่นำไปเผยแพร่หรือใช้กับงานอื่น</p></div></details><details class="group"><summary class="focus-visible:ring-focus-ring flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3 font-medium outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><h3 class="text-base font-medium">ถ้างานไม่ตรงมาตรฐาน</h3><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted mt-1 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="text-muted px-4 pb-4 leading-relaxed"><p>แจ้งเคลมได้ตามเงื่อนไขการรับประกัน เราตรวจสอบและดำเนินการตามที่ระบุไว้ในหน้าการรับประกันงาน</p><p class="mt-2"><a href="/guarantee" class="text-primary underline">ดูการรับประกันงาน</a></p></div></details><details class="group"><summary class="focus-visible:ring-focus-ring flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3 font-medium outline-none focus-visible:ring-2 [&amp;::-webkit-details-marker]:hidden"><h3 class="text-base font-medium">สั่งอะไรได้บ้าง</h3><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-muted mt-1 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg></summary><div class="text-muted px-4 pb-4 leading-relaxed"><p>ดูสินค้าทั้งหมดได้ที่หน้าสินค้า บางรายการเห็นราคาทันที บางรายการขอใบเสนอราคา</p><p class="mt-2"><a href="/products" class="text-primary underline">ดูสินค้าทั้งหมด</a></p></div></details></div></section><div class="bg-primary-subtle rounded-panel flex flex-wrap items-center justify-between gap-4 p-5 md:p-7"><p class="m-0 font-semibold">มาตรฐานการผลิตของ getpack</p><a href="/products">next.products</a></div></div></div>"`;

exports[`trust pages with nothing to show yet > reviews: says there are none and that samples are never used 1`] = `"<div class="mx-auto max-w-3xl px-4 py-8 md:py-12"><header><h1 class="text-3xl font-bold md:text-4xl">รีวิวจากลูกค้า</h1><p class="text-muted mt-2">รีวิวจากลูกค้าที่ได้รับสินค้าจริงเท่านั้น</p></header><div class="border-border bg-surface rounded-card flex flex-col items-center justify-center gap-3 border px-6 py-12 text-center mt-8"><span aria-hidden="true" class="border-border bg-surface-subtle text-muted mb-1 grid size-14 place-items-center rounded-xl border"><svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star shrink-0" aria-hidden="true" focusable="false"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg></span><p class="text-lg font-semibold text-balance">ยังไม่มีรีวิว</p><p class="text-muted max-w-[46ch] text-sm text-pretty">รีวิวจะแสดงเมื่อลูกค้าที่ได้รับสินค้าแล้วเขียนรีวิว เราไม่ใช้รีวิวตัวอย่าง</p><div class="mt-2 flex flex-wrap items-center justify-center gap-2"><a href="/products">next.products</a></div></div></div>"`;
