exports[`trust pages with nothing to show yet > network: holds the figures back and says why 1`] = `"<div class="mx-auto max-w-4xl px-4 py-8 md:py-12"><header><h1 class="text-3xl font-bold md:text-4xl">เครือข่ายโรงงานของ getpack</h1><p class="text-muted mt-2">งานของคุณผลิตโดยโรงงานพาร์ทเนอร์ที่ผ่านการตรวจสอบ เราไม่เปิดเผยชื่อโรงงาน แต่เปิดเผยวิธีตรวจและผลงานโดยรวม</p></header><div class="mt-8 flex flex-col gap-10"><section aria-labelledby="network-figures"><h2 id="network-figures" class="mb-3 text-xl font-semibold">ผลงานโดยรวม</h2><div class="flex gap-3 rounded-lg border p-3 text-sm border-info/25 bg-info-subtle text-info-subtle-fg"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info shrink-0 mt-0.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="font-medium">ยังไม่เผยแพร่ตัวเลข</p><div class="mt-1">เราจะแสดงตัวเลขเมื่อมีโรงงานอย่างน้อย 3 แห่ง และงานที่เสร็จอย่างน้อย 30 งานใน 90 วันล่าสุด เพื่อให้ตัวเลขมีความหมาย</div></div></div></section></div></div>"`;

