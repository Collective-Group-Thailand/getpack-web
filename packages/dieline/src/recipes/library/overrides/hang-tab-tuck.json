{
  "schemaVersion": 1,
  "id": "hang-tab-tuck",
  "base": "PK-TE-01",
  "variant": {
    "tuck_top": "reverse_tuck",
    "tuck_bottom": "tuck"
  },
  "variants": {
    "hang": {
      "euro_slot": {
        "hangHole": "euro"
      },
      "round_hole": {
        "hangHole": "round"
      },
      "sombrero_header": {
        "hangHole": "sombrero"
      }
    },
    "window": {
      "none": {
        "window": "none"
      },
      "front_window": {
        "window": "rect",
        "windowPanel": "front"
      },
      "top_window": {
        "window": "rect",
        "windowPanel": "lid"
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องฝาเสียบมีหูแขวน",
    "en": "Tuck end with hang tab"
  },
  "description": {
    "th": "หูแขวนยื่นจากด้านหลัง เจาะรูแบบยูโรหรือรูกลม สำหรับแขวนบนราวในร้าน ฝาบนพับจากด้านหน้า",
    "en": "A hang tab rises from the back with a euro slot or round hole for peg display; the top lid hinges from the front"
  },
  "materials": [
    "paperboard",
    "corrugated"
  ],
  "params": [
    {
      "ref": "length",
      "min": 20,
      "max": 400
    },
    {
      "ref": "width",
      "min": 15,
      "max": 300
    },
    {
      "ref": "height",
      "min": 20,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "thumbNotch",
    "hangerHeight",
    "hangHole",
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius",
    "insert",
    "cavityShape",
    "cavityGrid",
    "cavityLength",
    "cavityWidth"
  ],
  "defaults": {
    "@extends": "carton",
    "hangHole": "euro",
    "insert": "none",
    "cavityShape": "default",
    "cavityGrid": "1x1",
    "cavityLength": 50,
    "cavityWidth": 40
  },
  "presets": "carton",
  "body": {
    "module": "tube",
    "preset": "carton"
  },
  "closures": {
    "top": {
      "module": "tuck",
      "with": {
        "lid": "front"
      }
    },
    "bottom": {
      "module": "tuck",
      "with": {
        "lid": "back"
      }
    }
  },
  "features": [
    {
      "module": "hangTab",
      "with": {
        "end": "top"
      }
    },
    {
      "module": "window"
    },
    {
      "module": "dieCutInsert",
      "with": {
        "rotate": true,
        "floor": "3 * t"
      }
    }
  ],
  "legacy": {
    "patternKeys": [
      "pid:6",
      "pid:8"
    ]
  }
