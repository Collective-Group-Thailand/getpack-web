      },
      "values": {
        "length": 300,
        "width": 200,
        "height": 250
      }
    },
    {
      "id": "l",
      "label": {
        "th": "L 400 × 250 × 300",
        "en": "L 400 × 250 × 300"
      },
      "values": {
        "length": 400,
        "width": 250,
        "height": 300
      }
    }
