{
  "schemaVersion": 1,
  "id": "bottle-neck-carton",
  "base": "PK-SP-18",
  "variants": {
    "hang": {
      "none": {
        "hangHole": "none"
      },
      "euro_slot": {
        "hangHole": "euro"
      },
      "round_hole": {
        "hangHole": "round"
      },
      "sombrero_header": {
        "hangHole": "sombrero"
      }
    },
    "window": {
      "none": {
        "window": "none"
      },
      "front_window": {
        "window": "rect",
        "windowPanel": "front"
      },
      "top_window": {
        "window": "rect",
        "windowPanel": "lid",
        "windowWidth": 40,
        "windowHeight": 20
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องขวดทรงสูง ล็อกคอขวด",
    "en": "Tall bottle carton with neck lock"
  },
  "description": {
    "th": "กล่องทรงสูงสำหรับขวด แผ่นด้านในใต้ฝามีรูล็อกคอขวดกันโยก ก้นล็อกอัตโนมัติ เลือกหูแขวนและหน้าต่างได้",
    "en": "A tall carton for a bottle: an inner flap under the lid locks round the neck so it cannot rock; crash-lock bottom; hang tab and window are options"
  },
  "materials": ["paperboard", "corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 50,
      "max": 200
    },
    {
      "ref": "width",
      "min": 50,
      "max": 200
    },
    {
      "ref": "height",
      "min": 120,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "thumbNotch",
    "hangerHeight",
    "hangHole",
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius",
    "neckDiameter"
  ],
  "defaults": {
    "@extends": "carton",
    "length": 85,
    "width": 85,
    "height": 300,
    "hangHole": "none",
    "neckDiameter": 32
  },
  "presets": [
    {
      "id": "s",
      "label": {
        "th": "S 70 × 70 × 220",
        "en": "S 70 × 70 × 220"
      },
      "values": {
        "length": 70,
        "width": 70,
        "height": 220
      }
    },
    {
      "id": "m",
      "label": {
        "th": "M 85 × 85 × 300",
        "en": "M 85 × 85 × 300"
      },
      "values": {
        "length": 85,
        "width": 85,
        "height": 300
      }
    },
    {
      "id": "l",
      "label": {
        "th": "L 100 × 100 × 340",
        "en": "L 100 × 100 × 340"
      },
      "values": {
        "length": 100,
        "width": 100,
        "height": 340
      }
    }
  ],
  "body": {
    "module": "tube",
    "preset": "carton"
  },
  "closures": {
    "top": {
      "module": "tuck",
      "with": {
        "lid": "front"
      }
    },
    "bottom": {
      "module": "crashLock"
    }
  },
  "features": [
    {
      "module": "hangTab",
      "with": {
        "end": "top",
        "optional": true
      }
    },
    {
      "module": "neckLock",
      "with": {
        "end": "top"
      }
    },
    {
      "module": "window"
    }
  ]
}
