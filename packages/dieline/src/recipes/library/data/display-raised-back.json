{
  "schemaVersion": 1,
  "id": "display-raised-back",
  "base": "PK-DS-03",
  "variants": {
    "window": {
      "none": {
        "window": "none"
      },
      "front_window": {
        "window": "rect",
        "windowPanel": "front",
        "windowHeight": 30,
        "windowOffsetY": 18
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องโชว์ก้นล็อก หลังยกสูง",
    "en": "Auto-bottom display carton with raised back"
  },
  "description": {
    "th": "ก้นล็อกอัตโนมัติ ด้านบนเปิดโชว์สินค้า ด้านหน้าเว้าต่ำ ด้านหลังยกสูงเป็นป้าย เลือกหน้าต่างด้านหน้าได้",
    "en": "A crash-lock bottom and an open top: the front dips to show the goods and the back rises as a header; with an optional front window"
  },
  "materials": ["paperboard", "corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 20,
      "max": 400
    },
    {
      "ref": "width",
      "min": 15,
      "max": 300
    },
    {
      "ref": "height",
      "min": 20,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "thumbNotch",
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius"
  ],
  "defaults": {
    "@extends": "carton",
    "length": 150,
    "width": 100,
    "height": 120,
    "window": "none",
    "windowPanel": "front",
    "windowWidth": 60,
    "windowHeight": 30,
    "windowOffsetX": 0,
    "windowOffsetY": 0,
    "windowRadius": 6
  },
  "presets": [
    {
      "id": "s",
      "label": {
        "th": "S 120 × 80 × 100",
        "en": "S 120 × 80 × 100"
      },
      "values": {
        "length": 120,
        "width": 80,
        "height": 100
      }
    },
    {
      "id": "m",
      "label": {
        "th": "M 150 × 100 × 120",
        "en": "M 150 × 100 × 120"
      },
      "values": {
        "length": 150,
        "width": 100,
        "height": 120
      }
    },
    {
      "id": "l",
      "label": {
        "th": "L 220 × 150 × 160",
        "en": "L 220 × 150 × 160"
      },
      "values": {
        "length": 220,
        "width": 150,
        "height": 160
      }
    }
  ],
  "body": {
    "module": "tube",
    "preset": "carton"
  },
  "closures": {
    "top": {
      "module": "displayTop"
    },
    "bottom": {
      "module": "crashLock"
    }
  },
  "features": [
    {
      "module": "window"
    }
  ]
}
