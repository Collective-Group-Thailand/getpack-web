{
  "schemaVersion": 1,
  "id": "rsc-tuck-lid",
  "base": "PK-CS-08",
  "variants": {
    "hand_holes": {
      "none": {
        "handles": "none"
      },
      "end_panels": {
        "handles": "side"
      },
      "side_panels": {
        "handles": "long"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาเสียบ",
    "en": "Slotted box with tuck-in lid"
  },
  "description": {
    "th": "กล่องลูกฟูกฝาบนเป็นลิ้นเสียบจากแผงหลัง ปิดซ้ำได้โดยไม่ใช้เทป ก้นฝาชน",
    "en": "A corrugated box whose top is a lid with a tuck from the back panel, reclosable without tape; RSC bottom"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "handles",
    "grain",
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "tuck",
      "with": {
        "lid": "back"
      }
    },
    "bottom": {
      "module": "rsc"
    }
  },
  "features": [
    {
      "module": "handHoles"
    }
  ]
}
