{
  "schemaVersion": 1,
  "id": "hsc-lid",
  "base": "PK-CT-02",
  "variants": {
    "hand_holes": {
      "none": {
        "handles": "none"
      },
      "end_panels": {
        "handles": "side"
      },
      "side_panels": {
        "handles": "long"
      }
    },
    "vents": {
      "none": {
        "vents": "none"
      },
      "round": {
        "vents": "round"
      },
      "oblong": {
        "vents": "oblong"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาเปิดบน พร้อมฝาครอบ",
    "en": "Half-slotted body with telescope lid"
  },
  "description": {
    "th": "ตัวกล่อง HSC เปิดด้านบน มีฝาครอบสวมทับเป็นชิ้นแยก",
    "en": "An open-top half-slotted body with a separate telescope lid over it"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "handles",
    "grain",
    "lidDepth",
    "vents"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "vents": "none"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.trayDepth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "bottom": {
      "module": "rsc"
    }
  },
  "features": [
    {
      "module": "handHoles",
      "with": {
        "fromTop": "(lidDepth ?? max(15, round(height / 3))) + 15"
      }
    },
    {
      "module": "vents"
    },
    {
      "module": "telescopeLid"
    }
  ],
  "constraints": [
    {
      "id": "hsc-lid.hand_holes_below_lid",
      "code": "handle.too_small",
      "severity": "error",
      "param": "handles",
      "require": "not (handles != 'none' and height < (lidDepth ?? max(15, round(height / 3))) + 15 + 30 + 20)",
      "message": {
        "th": "ใต้ฝาครอบเหลือที่ไม่พอสำหรับช่องมือจับ",
        "en": "Below the lid there is no room for hand holes"
      }
    }
  ],
  "outerSize": {
    "length": "length + 4 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 4 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height + 2 * t"
  },
  "closedSize": {
    "length": "length + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height"
  }
}
