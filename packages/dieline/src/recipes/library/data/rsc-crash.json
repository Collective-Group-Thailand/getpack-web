{
  "schemaVersion": 1,
  "id": "rsc-crash",
  "base": "PK-CG-01",
  "variants": {
    "joint": {
      "glue_flap": {
        "joint": "glue"
      },
      "stitch_flap": {
        "joint": "stitch"
      },
      "tape_joint": {
        "joint": "tape"
      }
    },
    "hand_holes": {
      "none": {
        "handles": "none"
      },
      "end_panels": {
        "handles": "side"
      },
      "side_panels": {
        "handles": "long"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกก้นล็อกอัตโนมัติ",
    "en": "Corrugated crash-lock bottom box"
  },
  "description": {
    "th": "กล่องลูกฟูกติดกาวสำเร็จ กางออกแล้วก้นล็อกเอง ฝาบนแบบฝาชน",
    "en": "A ready-glued corrugated box whose bottom locks as it is opened; meeting flaps on top"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "handles",
    "grain"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "rsc"
    },
    "bottom": {
      "module": "crashLock"
    }
  },
  "features": [
    {
      "module": "handHoles"
    }
  ]
}
