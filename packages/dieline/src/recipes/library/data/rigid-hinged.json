    "en": "Rigid hinged-lid box"
  },
  "description": {
    "th": "ถาดกระดาษแข็งหุ้มกระดาษในปกแข็ง ฝาพับจากด้านหลัง เลือกการปิด ตัวรอง และหน้าต่างได้",
    "en": "A wrapped greyboard tray in a rigid case whose lid hinges at the back; closure, insert and window are options"
  },
  "materials": ["rigid"],
  "params": [
    {
      "ref": "length",
      "min": 60,
      "max": 450
    },
    {
      "ref": "width",
      "min": 50,
      "max": 350
    },
    {
      "ref": "height",
      "min": 20,
      "max": 150
    },
    "closureRigid",
    "insert",
    "grain",
    "window",
    {
      "ref": "windowPanel",
      "options": [
        {
          "value": "wall-front",
          "label": {
            "th": "ผนังหน้า",
            "en": "Front wall"
          }
        },
        {
          "value": "case-front",
          "label": {
            "th": "บนฝา",
            "en": "Lid"
          }
        }
      ]
    },
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius"
  ],
  "defaults": {
    "length": 200,
    "width": 150,
    "height": 60,
    "closureRigid": "none",
    "insert": "none",
    "grain": "across",
    "window": "none",
    "windowPanel": "case-front",
    "windowWidth": 80,
    "windowHeight": 50,
    "windowOffsetX": 0,
    "windowOffsetY": 0,
    "windowRadius": 6
  },
  "presets": [
    {
      "id": "s",
      "label": {
