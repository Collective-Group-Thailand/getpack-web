      },
      "values": {
        "length": 150,
        "width": 100,
        "height": 50
      }
    },
    {
      "id": "m",
      "label": {
        "th": "M 200 × 150 × 60",
        "en": "M 200 × 150 × 60"
      },
      "values": {
        "length": 200,
        "width": 150,
        "height": 60
      }
    },
    {
      "id": "l",
      "label": {
        "th": "L 300 × 220 × 80",
        "en": "L 300 × 220 × 80"
      },
      "values": {
        "length": 300,
        "width": 220,
        "height": 80
      }
    }
  ],
  "pieceSet": {
    "module": "rigidCase",
    "with": {
      "spine": "back"
    }
  },
  "features": [
    {
      "module": "window"
    },
    {
      "module": "dieCutInsert",
      "with": {
        "target": "base",
        "floor": "t"
      }
    }
  ],
  "outerSize": {
    "length": "length + 2 * t + 6",
    "width": "width + 2.5 * t + 6.15",
    "height": "height + 3.5 * t + 1.3"
