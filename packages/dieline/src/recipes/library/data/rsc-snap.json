{
  "schemaVersion": 1,
  "id": "rsc-snap",
  "base": "PK-CS-07",
  "variants": {
    "hand_holes": {
      "none": {
        "handles": "none"
      },
      "end_panels": {
        "handles": "side"
      },
      "side_panels": {
        "handles": "long"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาชน ก้นล็อก 1-2-3",
    "en": "Slotted box with snap-lock (1-2-3) bottom"
  },
  "description": {
    "th": "กล่องลูกฟูกฝาบนชนกลาง ก้นล็อก 1-2-3 พับประกอบโดยไม่ต้องใช้เทปที่ก้น",
    "en": "A corrugated slotted box: RSC top flaps, a 1-2-3 snap-lock bottom that closes without tape"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "handles",
    "grain"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "rsc"
    },
    "bottom": {
      "module": "snapLock123",
      "preset": "default"
    }
  },
  "features": [
    {
      "module": "handHoles"
    }
  ]
}
