{
  "schemaVersion": 1,
  "id": "te2-seal",
  "base": "PK-TE-02",
  "variant": {
    "tuck_top": "seal"
  },
  "variants": {
    "lock": {
      "friction": {
        "lock": "friction"
      },
      "slit_lock": {
        "lock": "slit"
      }
    },
    "tuck_corner": {
      "square": {
        "tuckCorners": "square"
      },
      "rounded": {
        "tuckCorners": "rounded"
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องฝาปิดกาว ก้นเสียบล็อกร่อง",
    "en": "Seal top, locking tuck bottom"
  },
  "description": {
    "th": "ฝาบนปิดกาว ก้นเป็นลิ้นเสียบที่ล็อกด้วยร่องหรือแรงเสียดทานกับปีกกันฝุ่น",
    "en": "Glued top; the bottom tuck locks by slits or friction against the dust flaps"
  },
  "materials": [
    "paperboard"
  ],
  "params": [
    {
      "ref": "length",
      "min": 20,
      "max": 400
    },
    {
      "ref": "width",
      "min": 15,
      "max": 300
    },
    {
      "ref": "height",
      "min": 20,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "lock",
    "glueWidth",
    "glueSide",
    "grain"
  ],
  "defaults": {
    "@extends": "carton",
    "lock": "friction"
  },
  "presets": "carton",
  "body": {
    "module": "tube",
    "preset": "carton"
  },
  "closures": {
    "top": {
      "module": "seal"
    },
    "bottom": {
      "module": "tuck",
      "with": {
        "lid": "back"
      }
    }
  },
  "features": [
    {
      "module": "slitLock",
      "with": {
        "end": "bottom"
      }
    }
  ]
}
