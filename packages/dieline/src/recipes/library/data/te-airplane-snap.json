{
  "schemaVersion": 1,
  "id": "te-airplane-snap",
  "base": "PK-TE-01",
  "variant": {
    "tuck_top": "airplane_tuck",
    "tuck_bottom": "snap_lock_123"
  },
  "variants": {
    "hang": {
      "none": {
        "hangHole": "none"
      },
      "euro_slot": {
        "hangHole": "euro"
      },
      "round_hole": {
        "hangHole": "round"
      },
      "sombrero_header": {
        "hangHole": "sombrero"
      }
    },
    "window": {
      "none": {
        "window": "none"
      },
      "front_window": {
        "window": "rect",
        "windowPanel": "front"
      },
      "top_window": {
        "window": "rect",
        "windowPanel": "lid"
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องฝาเสียบแบบเครื่องบิน ก้นล็อก 1-2-3",
    "en": "Airplane tuck top, snap-lock (1-2-3) bottom"
  },
  "description": {
    "th": "กล่องกระดาษแข็งฝาเสียบแบบเครื่องบินและก้นล็อก 1-2-3 ตามโครงสร้างตระกูลฝาเสียบ",
    "en": "Folding carton with a airplane tuck top and a snap-lock (1-2-3) bottom — the tuck-end family's closure pair"
  },
  "materials": ["paperboard", "corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 20,
      "max": 400
    },
    {
      "ref": "width",
      "min": 15,
      "max": 300
    },
    {
      "ref": "height",
      "min": 20,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "lockTongue",
    "hangerHeight",
    "hangHole",
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius",
    "insert",
    "cavityShape",
    "cavityGrid",
    "cavityLength",
    "cavityWidth",
    "headerShape",
    "headerShapeHeight",
    "headerPath"
  ],
  "defaults": {
    "@extends": "carton",
    "hangHole": "none",
    "insert": "none",
    "cavityShape": "default",
    "cavityGrid": "1x1",
    "cavityLength": 50,
    "cavityWidth": 40,
    "headerShape": "none",
    "headerPath": "M0 60 C20 0 80 0 100 60",
    "headerShapeHeight": 50
  },
  "presets": "carton",
  "body": {
    "module": "tube",
    "preset": "carton"
  },
  "closures": {
    "top": {
      "module": "airplaneTuck",
      "with": {
        "lid": "front"
      }
    },
    "bottom": {
      "module": "snapLock123",
      "preset": "default"
    }
  },
  "features": [
    {
      "module": "hangTab",
      "with": {
        "end": "top",
        "optional": true
      }
    },
    {
      "module": "window"
    },
    {
      "module": "dieCutInsert",
      "with": {
        "rotate": true,
        "floor": "3 * t"
      }
    },
    {
      "module": "shapedHeader",
      "with": {
        "end": "top"
      }
    }
  ]
}
