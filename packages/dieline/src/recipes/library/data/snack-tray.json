  "presets": [
    {
      "id": "hotdog",
      "label": {
        "th": "ฮอทด็อก 180 × 70 × 40",
        "en": "Hot dog 180 × 70 × 40"
      },
      "values": {
        "length": 180,
        "width": 70,
        "height": 40
      }
    },
    {
      "id": "snack",
      "label": {
        "th": "ของทอด 150 × 100 × 50",
        "en": "Snack 150 × 100 × 50"
      },
      "values": {
        "length": 150,
        "width": 100,
        "height": 50
      }
    }
  ],
  "body": {
    "module": "tray",
    "preset": "glued"
  },
  "features": [
    {
      "module": "lockCorners"
    },
    {
      "module": "dieCutInsert",
      "with": {
        "floor": "t"
      }
    }
  ],
  "outerSize": {
    "height": "height + t"
