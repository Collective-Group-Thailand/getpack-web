      "ref": "length",
      "min": 80,
      "max": 300
    },
    {
      "ref": "width",
      "min": 50,
      "max": 200
    },
    {
      "ref": "height",
      "min": 25,
      "max": 100
    },
    "cornerLock",
    "grain",
    "insert"
