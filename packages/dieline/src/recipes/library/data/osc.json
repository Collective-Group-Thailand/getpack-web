{
  "schemaVersion": 1,
  "id": "osc",
  "base": "PK-CS-05",
  "variants": {
    "joint": {
      "glue_flap": {
        "joint": "glue"
      },
      "stitch_flap": {
        "joint": "stitch"
      },
      "tape_joint": {
        "joint": "tape"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาเกยกัน (OSC)",
    "en": "Overlap slotted container (OSC)"
  },
  "description": {
    "th": "ฝานอกยาวเลยกึ่งกลางและเกยกัน ช่วยให้ปิดเทปแน่นและกันฝุ่นได้ดีกว่าฝาชน",
    "en": "Outer flaps reach past the centre and overlap, for a tighter seal than meeting flaps"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "grain",
    "flapOverlap"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "flapOverlap": 30
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "osc"
    },
    "bottom": {
      "module": "osc"
    }
  },
  "features": []
}
