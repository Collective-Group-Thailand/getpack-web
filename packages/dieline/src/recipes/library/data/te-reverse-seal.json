{
  "schemaVersion": 1,
  "id": "te-reverse-seal",
  "base": "PK-TE-01",
  "variant": {
    "tuck_top": "reverse_tuck",
    "tuck_bottom": "seal"
  },
  "variants": {
    "hang": {
      "none": {
        "hangHole": "none"
