    "tuckCorners",
    "dustFlapDepth",
    "thumbNotch",
    "hangerHeight",
    "hangHole",
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius"
  ],
  "defaults": {
    "@extends": "carton",
    "hangHole": "none"
