    },
    {
      "ref": "height",
      "min": 20,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "thumbNotch",
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius",
    "insert",
    "cavityShape",
    "cavityGrid",
    "cavityLength",
    "cavityWidth"
  ],
  "defaults": {
    "@extends": "carton",
    "insert": "none",
    "cavityShape": "default",
    "cavityGrid": "1x1",
    "cavityLength": 50,
    "cavityWidth": 40
  },
  "presets": "carton",
  "body": {
