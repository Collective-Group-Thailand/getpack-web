{
  "schemaVersion": 1,
  "id": "te-straight-seal",
  "base": "PK-TE-01",
  "variant": {
    "tuck_top": "straight_tuck",
    "tuck_bottom": "seal",
    "hang": "none"
  },
  "variants": {
