{
  "schemaVersion": 1,
  "id": "tape-free-box",
  "base": "PK-CG-03",
  "variants": {
    "tear_strip": {
      "none": {
        "tearStrip": false
      },
      "zip_tear_strip": {
        "tearStrip": true
      }
    },
    "adhesive": {
      "none": {
        "adhesive": "none"
      },
      "single_strip": {
        "adhesive": "single"
      },
      "dual_strip_return": {
        "adhesive": "dual"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกไม่ต้องใช้เทป",
    "en": "Tape-free shipping box"
  },
  "description": {
    "th": "ก้นล็อกอัตโนมัติ ฝาบนปิดด้วยแถบกาวในตัว เปิดด้วยแถบดึงฉีก ไม่ต้องใช้เทป",
    "en": "A crash-lock bottom, top flaps closed with a built-in adhesive strip and opened with a tear strip — no tape"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "glueWidth",
    "glueSide",
    "grain",
    "tearStrip",
    "adhesive"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "tearStrip": false,
    "adhesive": "single"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "rsc"
    },
    "bottom": {
      "module": "crashLock"
    }
  },
  "features": [
    {
      "module": "adhesiveStrip",
      "with": {
        "end": "top",
        "faces": ["flap-front-top", "flap-back-top"]
      }
    },
    {
      "module": "tearStrip"
    }
  ]
}
