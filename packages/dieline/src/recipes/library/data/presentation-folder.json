        "fingerHole": false
      },
      "thumb_notch": {
        "fingerHole": true
      }
    }
  },
  "category": "specialty",
  "name": {
    "th": "แฟ้มเสนองานมีกระเป๋า",
    "en": "Presentation folder"
  },
  "description": {
    "th": "แฟ้มกระดาษแข็งพับครึ่ง มีกระเป๋าด้านในทากาวสองข้าง เลือกรอยเว้านิ้วที่กระเป๋าได้",
    "en": "A folded paperboard folder with an inside pocket glued at both sides; with an optional finger notch in the pocket"
  },
  "materials": ["paperboard"],
  "params": [
    {
      "ref": "length",
      "min": 150,
      "max": 330
    },
    {
      "ref": "height",
      "min": 200,
      "max": 450
    },
    "spine",
    "pocketDepth",
    "fingerHole"
