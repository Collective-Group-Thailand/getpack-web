        "en": "A5 160 × 220"
      },
      "values": {
        "length": 160,
        "height": 220,
        "pocketDepth": 75
      }
    },
    {
      "id": "a4",
      "label": {
        "th": "A4 220 × 305",
        "en": "A4 220 × 305"
      },
      "values": {
        "length": 220,
        "height": 305,
        "pocketDepth": 100
      }
    },
    {
      "id": "letter",
      "label": {
        "th": "Letter 230 × 300",
        "en": "Letter 230 × 300"
      },
      "values": {
        "length": 230,
        "height": 300,
        "pocketDepth": 100
      }
    }
  ],
  "body": {
    "module": "presentationFolder"
  },
  "closedSize": {
    "length": "length",
    "width": "spine",
    "height": "height"
  },
  "outerSize": {
    "length": "length + t / 2",
    "width": "spine + 1.5 * t",
    "height": "height"
