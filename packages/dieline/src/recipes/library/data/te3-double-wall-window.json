{
  "schemaVersion": 1,
  "id": "te3-double-wall-window",
  "base": "PK-TE-03",
  "variants": {
    "window": {
      "front_window": {
        "window": "rect",
        "windowPanel": "wall-front"
      }
    },
    "thumb": {
      "none": {
        "fingerHole": false
      },
      "thumb_notch": {
        "fingerHole": true
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องฝาเสียบผนังสองชั้น หน้าต่างด้านหน้า",
    "en": "Double-wall tuck-front carton, front window"
  },
  "description": {
    "th": "ผนังข้างพับซ้อนสองชั้น ผนังหน้าชั้นเดียวมีหน้าต่าง ฝาพับติดผนังหลังปิดด้วยลิ้นเสียบ",
    "en": "End walls folded over double; a single front wall carries the window; a back-hinged lid with a front tuck"
  },
  "materials": ["paperboard"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 600
    },
    {
      "ref": "width",
      "min": 60,
      "max": 450
    },
    {
      "ref": "height",
      "min": 20,
      "max": 250
    },
    {
      "ref": "tuckDepth",
      "omit": ["help"]
    },
    "grain",
    "tuckCorners",
    "fingerHole",
    "window",
    {
      "ref": "windowPanel",
      "options": [
        {
          "value": "lid",
          "label": {
            "th": "บนฝา",
            "en": "Lid top"
          }
        },
        {
          "value": "wall-front",
          "label": {
            "th": "ผนังด้านหน้า",
            "en": "Front wall"
          }
        }
      ]
    },
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius",
    "insert",
    "cavityShape",
    "cavityGrid",
    "cavityLength",
    "cavityWidth"
  ],
  "defaults": {
    "length": 250,
    "width": 180,
    "height": 80,
    "grain": "across",
    "tuckCorners": "rounded",
    "fingerHole": false,
    "window": "none",
    "windowPanel": "lid",
    "windowWidth": 60,
    "windowHeight": 40,
    "windowOffsetX": 0,
    "windowOffsetY": 0,
    "windowRadius": 6,
    "insert": "none",
    "cavityShape": "default",
    "cavityGrid": "1x1",
    "cavityLength": 50,
    "cavityWidth": 40
  },
  "presets": [
    {
      "id": "small",
      "label": {
        "th": "เล็ก 200 × 150 × 50",
        "en": "Small 200 × 150 × 50"
      },
      "values": {
        "length": 200,
        "width": 150,
        "height": 50
      }
    },
    {
      "id": "medium",
      "label": {
        "th": "กลาง 250 × 180 × 80",
        "en": "Medium 250 × 180 × 80"
      },
      "values": {
        "length": 250,
        "width": 180,
        "height": 80
      }
    },
    {
      "id": "large",
      "label": {
        "th": "ใหญ่ 350 × 250 × 100",
        "en": "Large 350 × 250 × 100"
      },
      "values": {
        "length": 350,
        "width": 250,
        "height": 100
      }
    }
  ],
  "body": {
    "module": "tray",
    "preset": "glued"
  },
  "closures": {
    "top": {
      "module": "hingedLid",
      "with": {
        "front": "tuck"
      }
    }
  },
  "features": [
    {
      "module": "rollOverWalls",
      "with": {
        "walls": ["left", "right"]
      }
    },
    {
      "module": "trayWindow"
    },
    {
      "module": "dieCutInsert",
      "with": {
        "floor": "t"
      }
    }
  ],
  "outerSize": {
    "width": "width + 3 * t",
    "height": "height + t"
  }
}
