        "en": "60 × 40"
      },
      "values": {
        "length": 60,
        "width": 40
      }
    },
    {
      "id": "b",
      "label": {
        "th": "100 × 60",
        "en": "100 × 60"
      },
      "values": {
        "length": 100,
        "width": 60
      }
    }
  ],
  "body": {
    "module": "flatShape",
    "with": {
      "shape": "oval"
    }
  },
  "features": [
    {
      "module": "hangHole",
      "with": {
