{
  "schemaVersion": 1,
  "id": "full-telescope",
  "base": "PK-CT-01",
  "variants": {
    "lid_depth": {
      "full": {
        "lid": "full"
      },
      "partial": {
        "lid": "partial"
      }
    },
    "hand_holes": {
      "none": {
        "handles": "none"
      },
      "end_panels": {
        "handles": "side"
      },
      "side_panels": {
        "handles": "long"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาครอบ ถาดสองชิ้น",
    "en": "Full telescope, two trays"
  },
  "description": {
    "th": "ถาดลูกฟูกสองชิ้น ฝาครอบสวมทับตัวกล่องเต็มความสูงหรือบางส่วน",
    "en": "Two corrugated trays: a lid telescoping over the base, full depth or partly"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 100,
      "max": 800
    },
    {
      "ref": "width",
      "min": 80,
      "max": 600
    },
    {
      "ref": "height",
      "min": 40,
      "max": 600
    },
    "lid",
    "lidDepth",
    "handles",
    "grain"
  ],
  "defaults": {
    "length": 400,
    "width": 300,
    "height": 150,
    "lid": "full",
    "handles": "none",
    "grain": "across"
  },
  "presets": [
    {
      "id": "m",
      "label": {
        "th": "M 300 × 200 × 120",
        "en": "M 300 × 200 × 120"
      },
      "values": {
        "length": 300,
        "width": 200,
        "height": 120
      }
    },
    {
      "id": "l",
      "label": {
        "th": "L 400 × 300 × 150",
        "en": "L 400 × 300 × 150"
      },
      "values": {
        "length": 400,
        "width": 300,
        "height": 150
      }
    },
    {
      "id": "xl",
      "label": {
        "th": "XL 600 × 400 × 300",
        "en": "XL 600 × 400 × 300"
      },
      "values": {
        "length": 600,
        "width": 400,
        "height": 300
      }
    }
  ],
  "pieceSet": {
    "module": "lidAndBase"
  },
  "features": [
    {
      "module": "handHoles"
    }
  ],
  "constraints": [
    {
      "id": "full-telescope.hand_holes_below_lid",
      "code": "handle.too_small",
      "severity": "error",
      "param": "handles",
      "require": "not (handles != 'none' and lid != 'full' and height < (lidDepth ?? max(15, round(height / 3))) + 15 + 30 + 20)",
      "message": {
        "th": "ฝาครอบบางส่วนเหลือที่ใต้ฝาไม่พอสำหรับช่องมือจับ",
        "en": "Below a partial lid there is no room for hand holes"
      }
    }
  ],
  "closedSize": {
    "length": "length + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height"
  }
}
