  "defaults": {
    "@extends": "carton",
    "length": 150,
    "width": 80,
    "height": 100,
    "handleHeight": 40
  },
  "presets": [
    {
      "id": "cake",
      "label": {
        "th": "ขนม 150 × 80 × 100",
        "en": "Cakes 150 × 80 × 100"
      },
      "values": {
        "length": 150,
        "width": 80,
        "height": 100
      }
    },
    {
      "id": "gift",
      "label": {
        "th": "ของฝาก 200 × 100 × 120",
        "en": "Gifts 200 × 100 × 120"
      },
      "values": {
        "length": 200,
        "width": 100,
        "height": 120
      }
    }
  ],
  "body": {
