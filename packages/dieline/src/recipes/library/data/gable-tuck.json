    "tuck_bottom": "tuck"
  },
  "variants": {
    "window": {
      "none": {
        "window": "none"
      },
      "front_window": {
        "window": "rect",
        "windowPanel": "front"
      }
    }
  },
  "category": "folding_carton",
  "name": {
