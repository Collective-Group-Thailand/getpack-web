{
  "schemaVersion": 1,
  "id": "display-tray",
  "base": "PK-DS-01",
  "variants": {
    "corner": {
      "glued": {
        "cornerLock": "glued"
      },
      "lock_corner": {
        "cornerLock": "lock"
      }
    },
    "insert": {
      "none": {
        "insert": "none"
      },
      "die_cut_insert": {
        "insert": "die_cut"
      }
    }
  },
  "category": "specialty",
  "name": {
    "th": "ถาดโชว์สินค้าหน้าเคาน์เตอร์ มีแผ่นหัวโชว์",
    "en": "Counter display tray with header card"
  },
  "description": {
    "th": "ถาดวางหน้าเคาน์เตอร์ ผนังหลังต่อขึ้นเป็นแผ่นหัวโชว์สำหรับพิมพ์โฆษณา",
    "en": "A counter tray whose back wall carries on up into a printed header card"
  },
  "materials": ["paperboard", "corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 30,
      "max": 600
    },
    {
      "ref": "width",
      "min": 30,
      "max": 400
    },
    {
      "ref": "height",
      "min": 10,
      "max": 200
    },
    "cornerFlap",
    "grain",
    "headerHeight",
    "cornerLock",
    "insert"
  ],
  "defaults": {
    "length": 200,
    "width": 150,
    "height": 60,
    "grain": "across",
    "cornerLock": "glued",
    "insert": "none",
    "headerHeight": 120
  },
  "presets": [
    {
      "id": "small",
      "label": {
        "th": "ถาดเล็ก 120 × 120 × 50",
        "en": "Small 120 × 120 × 50"
      },
      "values": {
        "length": 120,
        "width": 120,
        "height": 50
      }
    },
    {
      "id": "medium",
      "label": {
        "th": "ถาดกลาง 200 × 150 × 60",
        "en": "Medium 200 × 150 × 60"
      },
      "values": {
        "length": 200,
        "width": 150,
        "height": 60
      }
    },
    {
      "id": "large",
      "label": {
        "th": "ถาดใหญ่ 300 × 220 × 80",
        "en": "Large 300 × 220 × 80"
      },
      "values": {
        "length": 300,
        "width": 220,
        "height": 80
      }
    }
  ],
  "body": {
    "module": "tray",
    "preset": "glued"
  },
  "features": [
    {
      "module": "displayHeader"
    },
    {
      "module": "lockCorners"
    },
    {
      "module": "dieCutInsert",
      "with": {
        "floor": "t"
      }
    }
  ],
  "outerSize": {
    "height": "height + t"
  }
}
