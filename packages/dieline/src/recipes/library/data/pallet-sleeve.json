{
  "schemaVersion": 1,
  "id": "pallet-sleeve",
  "base": "PK-CB-03",
  "variants": {
    "hand_holes": {
      "none": {
        "handles": "none"
      },
      "end_panels": {
        "handles": "side"
      },
      "side_panels": {
        "handles": "long"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "ปลอกพาเลทพร้อมฝาบนและถาดล่าง",
    "en": "Pallet sleeve with cap and base tray"
  },
  "description": {
    "th": "ปลอกลูกฟูกสวมรอบสินค้าบนพาเลท มีฝาครอบด้านบนและถาดรองด้านล่าง เลือกช่องมือจับได้",
    "en": "A corrugated sleeve round a pallet load, with a cap on top and a base tray beneath; hand holes are an option"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 600,
      "max": 1300
    },
    {
      "ref": "width",
      "min": 500,
      "max": 1200
    },
    {
      "ref": "height",
      "min": 300,
      "max": 1500
    },
    "glueWidth",
    "glueSide",
    "grain",
    "lidDepth",
    "handles"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "handles": "none",
    "length": 1100,
    "width": 1000,
    "height": 900,
    "lidDepth": 120
  },
  "presets": [
    {
      "id": "eu",
      "label": {
        "th": "EU 1150 × 750 × 800",
        "en": "EU 1150 × 750 × 800"
      },
      "values": {
        "length": 1150,
        "width": 750,
        "height": 800
      }
    },
    {
      "id": "std",
      "label": {
        "th": "STD 1100 × 1000 × 900",
        "en": "STD 1100 × 1000 × 900"
      },
      "values": {
        "length": 1100,
        "width": 1000,
        "height": 900
      }
    },
    {
      "id": "tall",
      "label": {
        "th": "TALL 1100 × 1000 × 1200",
        "en": "TALL 1100 × 1000 × 1200"
      },
      "values": {
        "length": 1100,
        "width": 1000,
        "height": 1200
      }
    }
  ],
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "features": [
    {
      "module": "handHoles",
      "with": {
        "fromTop": "(lidDepth ?? 120) + 30"
      }
    },
    {
      "module": "telescopeLid"
    },
    {
      "module": "telescopeLid",
      "with": {
        "end": "bottom"
      }
    }
  ],
  "constraints": [
    {
      "id": "hsc-lid.hand_holes_below_lid",
      "code": "handle.too_small",
      "severity": "error",
      "param": "handles",
      "require": "not (handles != 'none' and height < (lidDepth ?? max(15, round(height / 3))) + 15 + 30 + 20)",
      "message": {
        "th": "ใต้ฝาครอบเหลือที่ไม่พอสำหรับช่องมือจับ",
        "en": "Below the lid there is no room for hand holes"
      }
    }
  ],
  "outerSize": {
    "length": "length + 4 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 4 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height + 2 * t"
  },
  "closedSize": {
    "length": "length + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height"
  }
}
