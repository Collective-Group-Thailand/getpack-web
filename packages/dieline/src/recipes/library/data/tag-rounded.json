        "hangHole": "none"
      },
      "euro_slot": {
        "hangHole": "euro"
      },
      "round_hole": {
        "hangHole": "round"
      },
      "sombrero_header": {
        "hangHole": "sombrero"
      }
    }
  },
  "category": "flat",
  "name": {
    "th": "ป้ายแขวน สี่เหลี่ยมมุมมน",
    "en": "Hang tag, rounded rectangle"
  },
  "description": {
    "th": "ป้ายแขวนสินค้า เลือกรูแขวนได้",
