    "width": 60,
    "cornerRadius": 6,
    "hangHole": "none"
  },
  "presets": "label",
  "body": {
    "module": "flatShape",
    "with": {
      "shape": "rounded_rectangle"
    }
  },
  "features": [
    {
      "module": "hangHole",
      "with": {
        "cx": "length / 2",
        "cy": "14"
      }
    }
  ]
