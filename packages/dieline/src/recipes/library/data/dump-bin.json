{
  "schemaVersion": 1,
  "id": "dump-bin",
  "base": "PK-DS-06",
  "variants": {
    "header": {
      "none": {
        "headerShape": "none"
      },
      "header_card": {
        "headerShape": "arch"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "ถังโชว์สินค้าลูกฟูก (ดัมพ์บิน)",
    "en": "Corrugated dump bin"
  },
  "description": {
    "th": "ถังลูกฟูกตั้งพื้น ปากเปิด ก้นล็อกอัตโนมัติ มีหัวโชว์ต่อจากผนังหลัง",
    "en": "A free-standing open corrugated bin with a crash-lock bottom and a header carried up from the back wall"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 200,
      "max": 1000
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "grain",
    "headerShape",
    {
      "ref": "headerShapeHeight",
      "min": 50,
      "max": 600
    },
    "headerPath"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "headerShape": "none",
    "headerShapeHeight": 250,
    "headerPath": "M0 60 C20 0 80 0 100 60",
    "length": 500,
    "width": 400,
    "height": 500
  },
  "presets": [
    {
      "id": "m",
      "label": {
        "th": "กลาง 400 × 300 × 450",
        "en": "Medium 400 × 300 × 450"
      },
      "values": {
        "length": 400,
        "width": 300,
        "height": 450
      }
    },
    {
      "id": "l",
      "label": {
        "th": "ใหญ่ 500 × 400 × 500",
        "en": "Large 500 × 400 × 500"
      },
      "values": {
        "length": 500,
        "width": 400,
        "height": 500
      }
    }
  ],
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "openEnd"
    },
    "bottom": {
      "module": "crashLock"
    }
  },
  "features": [
    {
      "module": "shapedHeader",
      "with": {
        "end": "top"
      }
    }
  ]
}
