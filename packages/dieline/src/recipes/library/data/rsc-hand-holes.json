{
  "schemaVersion": 1,
  "id": "rsc-hand-holes",
  "base": "PK-CS-06",
  "variants": {
    "joint": {
      "glue_flap": {
        "joint": "glue"
      },
      "stitch_flap": {
        "joint": "stitch"
      },
      "tape_joint": {
        "joint": "tape"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาชน มีช่องมือจับ",
    "en": "Regular slotted container with hand holes"
  },
  "description": {
    "th": "กล่องฝาชน (RSC) เจาะช่องมือจับที่ด้านข้างทั้งสอง สำหรับยกของหนัก",
    "en": "A regular slotted container with hand holes in both end panels, for heavier goods"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "joint",
    "glueWidth",
    "glueSide",
    "handles",
    "grain"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "handles": "side"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.depth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "top": {
      "module": "rsc"
    },
    "bottom": {
      "module": "rsc"
    }
  },
  "features": [
    {
      "module": "handHoles"
    }
  ]
}
