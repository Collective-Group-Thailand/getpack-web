{
  "schemaVersion": 1,
  "id": "tear-display-seal",
  "base": "PK-DS-02",
  "variant": {
    "tuck_bottom": "seal"
  },
  "variants": {
    "hang": {
      "none": {
        "hangHole": "none"
      },
      "euro_slot": {
        "hangHole": "euro"
      },
      "round_hole": {
        "hangHole": "round"
      },
      "sombrero_header": {
        "hangHole": "sombrero"
      }
    }
  },
  "category": "folding_carton",
  "name": {
    "th": "กล่องฉีกเป็นดิสเพลย์ ก้นกาว",
    "en": "Tear-away display carton, glued seal bottom"
  },
  "description": {
    "th": "ฉีกตามเส้นปรุ ส่วนบนด้านหน้าหลุดออก กลายเป็นกล่องโชว์สินค้าบนเคาน์เตอร์ ด้านหลังเต็มความสูง เลือกหูแขวนได้",
    "en": "Tear along the perforation and the top front lifts away, leaving a counter display with a full-height back; with an optional hang tab"
  },
  "materials": ["paperboard", "corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 20,
      "max": 400
    },
    {
      "ref": "width",
      "min": 15,
      "max": 300
    },
    {
      "ref": "height",
      "min": 20,
      "max": 450
    },
    "tuckDepth",
    "tuckCorners",
    "dustFlapDepth",
    "thumbNotch",
    "hangerHeight",
    "hangHole",
    "glueWidth",
    "glueSide",
    "grain"
  ],
  "defaults": {
    "@extends": "carton",
    "hangHole": "none"
  },
  "presets": "carton",
  "body": {
    "module": "tube",
    "preset": "carton"
  },
  "closures": {
    "top": {
      "module": "tuck",
      "with": {
        "lid": "front"
      }
    },
    "bottom": {
      "module": "seal"
    }
  },
  "features": [
    {
      "module": "hangTab",
      "with": {
        "end": "top",
        "optional": true
      }
    },
    {
      "module": "tearLine",
      "with": {
        "front": "depth * 0.45",
        "back": "0"
      }
    }
  ]
}
