{
  "schemaVersion": 1,
  "id": "bulk-bin",
  "base": "PK-CB-01",
  "variants": {
    "lid_depth": {
      "full": {
        "lid": "full"
      },
      "partial": {
        "lid": "partial"
      }
    }
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องบรรจุภัณฑ์ขนาดใหญ่ (บนพาเลท)",
    "en": "Bulk bin / pallet box"
  },
  "description": {
    "th": "กล่องลูกฟูกหนาขนาดเท่าพาเลท ก้นฝาชน มีฝาครอบเต็มหรือบางส่วน",
    "en": "A heavy corrugated bin sized to the pallet, with a slotted bottom and a full or partial cover"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 600,
      "max": 1300
    },
    {
      "ref": "width",
      "min": 500,
      "max": 1200
    },
    {
      "ref": "height",
      "min": 300,
      "max": 1200
    },
    "joint",
    "glueWidth",
    "glueSide",
    "grain",
    "lid",
    "lidDepth"
  ],
  "defaults": {
    "@extends": "slotted",
    "joint": "glue",
    "lid": "partial",
    "length": 1100,
    "width": 1000,
    "height": 800,
    "vents": "none",
    "handles": "none"
  },
  "presets": [
    {
      "id": "eu",
      "label": {
        "th": "EU 1150 × 750 × 700",
        "en": "EU 1150 × 750 × 700"
      },
      "values": {
        "length": 1150,
        "width": 750,
        "height": 700
      }
    },
    {
      "id": "std",
      "label": {
        "th": "STD 1100 × 1000 × 800",
        "en": "STD 1100 × 1000 × 800"
      },
      "values": {
        "length": 1100,
        "width": 1000,
        "height": 800
      }
    },
    {
      "id": "tall",
      "label": {
        "th": "TALL 1100 × 1000 × 1000",
        "en": "TALL 1100 × 1000 × 1000"
      },
      "values": {
        "length": 1100,
        "width": 1000,
        "height": 1000
      }
    }
  ],
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "joint == 'tape' ? side : side - a.gluePanel",
        "depth": "height + a.trayDepth",
        "glue": "joint == 'tape' ? 0 : (joint == 'stitch' ? max(35, glueWidth ?? glueWidthFor(width)) : (glueWidth ?? glueWidthFor(width)))"
      }
    }
  },
  "closures": {
    "bottom": {
      "module": "rsc"
    }
  },
  "features": [
    {
      "module": "telescopeLid"
    }
  ],
  "constraints": [
    {
      "id": "hsc-lid.hand_holes_below_lid",
      "code": "handle.too_small",
      "severity": "error",
      "param": "handles",
      "require": "not (handles != 'none' and height < (lidDepth ?? max(15, round(height / 3))) + 15 + 30 + 20)",
      "message": {
        "th": "ใต้ฝาครอบเหลือที่ไม่พอสำหรับช่องมือจับ",
        "en": "Below the lid there is no room for hand holes"
      }
    }
  ],
  "outerSize": {
    "length": "length + 4 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 4 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height + 2 * t"
  },
  "closedSize": {
    "length": "length + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "width": "width + 2 * t + 2 * C.LID_CLEARANCE_MM",
    "height": "height"
  }
}
