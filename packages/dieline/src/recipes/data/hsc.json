{
  "schemaVersion": 1,
  "id": "hsc",
  "base": "PK-CS-02",
  "variant": {
    "joint": "glue_flap"
  },
  "category": "corrugated",
  "name": {
    "th": "กล่องลูกฟูกฝาเดียว (HSC)",
    "en": "Half slotted container (HSC)"
  },
  "description": {
    "th": "เหมือนกล่องฝาชนแต่ไม่มีฝาบน ใช้คู่กับฝาครอบหรือเป็นถาดลึก",
    "en": "An RSC without top flaps — used with a separate lid or as a deep tray"
  },
  "codes": {
    "fefco": "0200"
  },
  "materials": ["corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 80,
      "max": 1200
    },
    {
      "ref": "width",
      "min": 60,
      "max": 800
    },
    {
      "ref": "height",
      "min": 40,
      "max": 1000
    },
    "glueWidth",
    "glueSide",
    "handles",
    "grain"
  ],
  "defaults": {
    "@extends": "slotted"
  },
  "presets": "slotted",
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "side - a.gluePanel",
        "depth": "height + a.trayDepth",
        "glue": "glueWidth ?? glueWidthFor(width)"
      }
    }
  },
  "closures": {
    "bottom": {
      "module": "rsc"
    }
  },
  "features": [
    {
      "module": "handHoles"
    }
  ],
  "legacy": {
    "patternKeys": []
  }
}
