{
  "schemaVersion": 1,
  "id": "sleeve",
  "base": "PK-SL-01",
  "category": "folding_carton",
  "name": {
    "th": "ปลอกสวม",
    "en": "Sleeve"
  },
  "description": {
    "th": "ปลอกเปิดหัวท้ายสวมทับถาดหรือสินค้า ความสูงคือความกว้างของปลอก",
    "en": "An open-ended band over a tray or product; the height is the band's width"
  },
  "materials": ["paperboard", "corrugated"],
  "params": [
    {
      "ref": "length",
      "min": 20,
      "max": 500
    },
    {
      "ref": "width",
      "min": 10,
      "max": 400
    },
    {
      "ref": "height",
      "min": 15,
      "max": 400
    },
    "glueWidth",
    "glueSide",
    "grain",
    "window",
    "windowPanel",
    "windowWidth",
    "windowHeight",
    "windowOffsetX",
    "windowOffsetY",
    "windowRadius"
  ],
  "defaults": {
    "length": 120,
    "width": 80,
    "height": 60,
    "glueSide": "left",
    "grain": "across",
    "windowPanel": "front",
    "window": "none",
    "windowWidth": 40,
    "windowHeight": 30,
    "windowOffsetX": 0,
    "windowOffsetY": 0,
    "windowRadius": 6
  },
  "presets": [
    {
      "id": "soap",
      "label": {
        "th": "สบู่ 90 × 60 × 40",
        "en": "Soap bar 90 × 60 × 40"
      },
      "values": {
        "length": 90,
        "width": 60,
        "height": 40
      }
    },
    {
      "id": "gift",
      "label": {
        "th": "ของขวัญ 200 × 150 × 80",
        "en": "Gift 200 × 150 × 80"
      },
      "values": {
        "length": 200,
        "width": 150,
        "height": 80
      }
    }
  ],
  "body": {
    "module": "tube",
    "preset": "carton",
    "with": {
      "dims": {
        "front": "length + a.panel",
        "side": "width + a.panel",
        "closingSide": "side - a.gluePanel",
        "glue": "glueWidth ?? glueWidthFor(width)"
      },
      "depth": "height",
      "piece": {
        "id": "blank",
        "label": "sleeve"
      }
    }
  },
  "features": [
    {
      "module": "window"
    }
  ],
  "legacy": {
    "patternKeys": ["pid:3"]
  }
}
