    "/v1/store/sample-kits/actions/request": {
      "post": {
        "operationId": "store.sampleKits.request",
        "summary": "Order a sample kit to an address; a paid kit comes back with a payment link",
        "tags": [
          "store"
        ],
        "x-contract-request": "store.sample-kits",
        "security": [
          {},
          {
            "customer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kitCode": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "interest": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "recipientName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "phone": {
                        "type": "string",
                        "pattern": "^0\\d{8,9}$"
                      },
                      "line1": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "subdistrict": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "district": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "province": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "postcode": {
                        "type": "string",
                        "pattern": "^\\d{5}$"
                      }
                    },
                    "required": [
                      "recipientName",
                      "phone",
                      "line1",
                      "province",
                      "postcode"
                    ]
                  }
                },
                "required": [
                  "kitCode",
                  "address"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order a sample kit to an address; a paid kit comes back with a payment link",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requestNo": {
                      "type": "string"
                    },
                    "status": {
                      "$ref": "#/components/schemas/SampleKitRequestStatus"
                    },
                    "payUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "shipsBy": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "requestNo",
                    "status",
                    "payUrl",
                    "shipsBy"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "4XX": {
            "description": "Problem details (api-conventions §3)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
